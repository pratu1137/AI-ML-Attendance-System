SECRET_KEY=replace-this-with-a-long-random-secret
DATABASE_URL=sqlite:///attendance.db
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
FACE_RECOGNITION_THRESHOLD=0.75
ATTENDANCE_WINDOW_BEFORE_MINUTES=0
ATTENDANCE_WINDOW_AFTER_MINUTES=0
ATTENDANCE_LATE_AFTER_MINUTES=10
TRUST_PROXY=false
APP_TIMEZONE=Asia/Kolkata
# Production deployments must set a PostgreSQL DATABASE_URL and a strong SECRET_KEY.